# Copy this file to .env and fill in your own values.
PORT=4000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://msme:change-me@localhost:5432/msme_pack

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts. Long by default because many users share or rarely re-open the app.
JWT_EXPIRES_IN=30d

# Comma-separated list of web origins allowed to call the API in development.
CORS_ORIGINS=http://localhost:5173

# Where uploaded guide audio is kept. On Railway, point this at the volume, e.g. /data/media
# MEDIA_DIR=

# Phone numbers (comma-separated) to make content admins each time the app starts.
# The person must have signed up first.
# ADMIN_PHONES=0244123456
