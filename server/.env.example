# Copy this file to .env and fill in your own values.
PORT=4000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://msme:change-me@localhost:5432/msme_pack

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts. Long by default because many users share or rarely re-open the app.
JWT_EXPIRES_IN=30d

# Comma-separated list of web origins allowed to call the API in development.
CORS_ORIGINS=http://localhost:5173

# Where uploaded guide audio is kept. On Railway, point this at the volume, e.g. /data/media
# MEDIA_DIR=

# Phone numbers (comma-separated) to make content admins each time the app starts.
# The person must have signed up first.
# ADMIN_PHONES=0244123456

# Text messages (SMS), optional. Leave SMS_PROVIDER empty to keep SMS off.
# SMS_PROVIDER=arkesel          # or hubtel
# SMS_SENDER=MSMEPack           # sender ID registered with the provider, up to 11 letters
# SMS_API_KEY=                  # Arkesel API key
# HUBTEL_CLIENT_ID=             # Hubtel client ID
# HUBTEL_CLIENT_SECRET=         # Hubtel client secret
# SMS_DAILY_LIMIT=30            # most SMS one business may send a day (reminders, receipts, logins)
# APP_URL=https://your-app.up.railway.app   # address used in links inside SMS (optional)
