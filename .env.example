# Copy this file to .env and fill in real values before running locally.
# On Railway/Render, you set these in the hosting dashboard instead of a file.

# A long, random secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep this secret. Anyone with it could forge a login session.
JWT_SECRET=

# Optional. Defaults to 3000 if not set. Most hosting providers set this
# automatically and you can leave it blank.
PORT=
